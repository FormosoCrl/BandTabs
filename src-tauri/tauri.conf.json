{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BandTabs",
  "version": "0.2.0",
  "identifier": "io.github.formosocrl.bandtabs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "BandTabs",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Visor y reproductor de tablaturas open source",
    "license": "GPL-3.0-or-later",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "publisher": "BandTabs",
    "category": "Music",
    "resources": {
      "engine/bandtabs_engine.py": "engine/bandtabs_engine.py",
      "engine/install.ps1": "engine/install.ps1",
      "engine/requirements.lock": "engine/requirements.lock"
    }
  }
}
